ex:OocOmBocSocTrang a owl:NamedIndividual,
        ich:EventHeritage ;
    rdfs:label "Oóc Om Bóc Sóc Trăng"@vi ;
    rdfs:comment "Ghi chú (CSV): MÂU THUẪN '2015 vs 2022': dsvh.gov.vn + Nhân Dân ghi QĐ 74/QĐ-BVHTTDL ngày 12/01/2022; số 'năm 2015' chỉ thấy ở duaghengo.vn (cổng không phải nhà nước): https://duaghengo.vn/ ; vài bài báo gõ nhầm 02/01/2021 hoặc 12/1/2021 (vjst.vn, baosoctrang). Chọn 12/01/2022. Tên mục trong QĐ là lễ hội đua ghe Ngo; Oóc Om Bóc là lễ hội chứa nó, tách `part_of`. Từ 2025 tổ chức dưới tên Cần Thơ: https://duaghengo.vn/ nêu 2026 khai mạc 22/11, đua 23–24/11 (nguồn không phải nhà nước)."@vi,
        "Mức verify (CSV): Cao"@vi,
        "Quy tắc thời gian (CSV): Gắn Oóc Om Bóc: ngày 15 tháng Kadeuk (xấp xỉ rằm tháng 10 âm Việt). Đua ghe 2 ngày quanh rằm"@vi,
        "Địa bàn gốc trong Danh mục: huyện Thạnh Trị, huyện Châu Thành, huyện Mỹ Xuyên, TP Sóc Trăng, tỉnh Sóc Trăng"@vi,
        "Địa bàn sau 2025 (CSV): phường Sóc Trăng (← phường 5,6,7,8), phường Phú Lợi; các xã còn lại: [chưa verify]"@vi ;
    ich:altLabelKhmerTranslit "Ok Om Bok" ;
    ich:altLabelListing "Lễ hội Đua ghe Ngo của người Khmer tỉnh Sóc Trăng"@vi ;
