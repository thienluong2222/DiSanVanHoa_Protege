ex:CungBienMyLong a owl:NamedIndividual,
        ich:EventHeritage ;
    rdfs:label "Lễ hội cúng biển Mỹ Long"@vi ;
    rdfs:comment "Ghi chú (CSV): Prompt 1 chỉ có blog; nay đã có dsvh + cổng Trà Vinh → nâng cấp mức tin cậy. Nghi thức: Tiền giảng, Nghinh Nam Hải, Tế Thần Nông và chiến sĩ trận vong, Chánh tế Chúa Xứ, Nghinh ngũ phương, Tống tàu."@vi,
        "Mức verify (CSV): Cao (QĐ, rule, địa điểm gốc)"@vi,
        "Quy tắc thời gian (CSV): 10–12/5 âm; tống tàu 12/5"@vi,
        "Địa bàn gốc trong Danh mục: xã Mỹ Long Bắc, xã Mỹ Long Nam và thị trấn Mỹ Long, huyện Cầu Ngang, tỉnh Trà Vinh"@vi,
        "Địa bàn sau 2025 (CSV): xã Mỹ Long (hoặc tương đương): [chưa verify]"@vi ;
    ich:altLabelNoDiacritics "Le hoi cung bien My Long" ;
    ich:datasetId 11 ;
    ich:hasListing ex:Listing_CungBienMyLong_QG ;
    ich:hasLocality ex:MieuBaChuaXuMyLong ;
    ich:hasTemporalRule ex:CungBienMyLong_Rule_Main ;
    ich:listingName "Lễ hội cúng biển Mỹ Long"@vi ;
    ich:registryStatus "listed" ;
    ich:source "https://dangcongsan.org.vn/travinh/tin-tuc-hoat-dong/di-san-van-hoa-phi-vat-the-quoc-gia-o-tinh-tra-vinh.html"^^xsd:anyURI,
        "https://dsvh.gov.vn/danh-muc-di-san-van-hoa-phi-vat-the-quoc-gia-1789"^^xsd:anyURI ;
    ich:typicallyIncludes ich:LeNghinhThanNamHai,
        ich:LeTeThanNong,
        ich:TongTau ;
    ich:unescoDomain ich:SocialPracticesRitualsFestive ;
    ich:verificationStatus "verified" ;
    ich:vnCategory ich:LeHoiTruyenThong .

