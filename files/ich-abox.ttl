ex:ChoNoiCaiRang a owl:NamedIndividual,
        ich:PracticeHeritage ;
    rdfs:label "Văn hóa chợ nổi Cái Răng"@vi ;
    rdfs:comment "Ghi chú (CSV): Hồ sơ mô tả gồm tập quán – tín ngưỡng Bà–Cậu, Thần tài–Thổ địa, tri thức dân gian (Bảo tàng Cần Thơ). Ngày hội Du lịch là sự kiện du lịch gắn di sản, không phải occurrence của di sản."@vi,
        "Mốc 2024 trong CSV occurrence bị bỏ qua: Ngày hội Du lịch là sự kiện du lịch gắn di sản, không phải occurrence (CSV notes); PracticeHeritage không có Occurrence."@vi,
        "Mức verify (CSV): QĐ: xác nhận (nguồn nhà nước địa phương + báo). Loại hình: nguồn thứ cấp."@vi,
        "Quy tắc thời gian (CSV): Họp hằng ngày; khung đẹp nhất khoảng 5–7h sáng"@vi,
        "Địa bàn gốc trong Danh mục: quận Cái Răng, TP Cần Thơ"@vi,
        "Địa bàn sau 2025 (CSV): phường Cái Răng (hợp nhất từ Lê Bình, Ba Láng, Hưng Thạnh, Thường Thạnh; nguồn thứ cấp)"@vi ;
    ich:altLabelListing "Văn hóa chợ nổi Cái Răng"@vi ;
    ich:altLabelNoDiacritics "Cho noi Cai Rang" ;
    ich:confusableWith ex:ChoNoiCaiBe,
        ex:ChoNoiNgaBay,
        ex:ChoNoiPhongDien ;
    ich:datasetId 1 ;
    ich:hasCue ex:SongCanTho,
        ich:CayBeo,
        ich:GheThuongHo ;
    ich:hasDistinctiveCue ich:MatSongDongGhe ;
    ich:hasListing ex:Listing_ChoNoiCaiRang_QG ;
    ich:hasLocality ex:Place_ChoNoiCaiRang ;
    ich:hasTemporalCue ich:SangSom ;
    ich:involvesRole ich:ThuongHo ;
    ich:listingName "Văn hóa chợ nổi Cái Răng"@vi ;
    ich:registryStatus "listed" ;
    ich:source "https://baolaocai.vn/ngay-hoi-du-lich-van-hoa-cho-noi-cai-rang-gan-ket-va-bao-ton-di-san-post370604.html"^^xsd:anyURI,
