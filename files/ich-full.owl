  <rdf:Description rdf:about="https://w3id.org/ich-mekong/data#CholChnamThmay">
    <ich:typicallyIncludes rdf:resource="https://w3id.org/ich-mekong/ontology#MuaRomVong"/>
    <ich:typicallyIncludes rdf:resource="https://w3id.org/ich-mekong/ontology#LeTamPhat"/>
