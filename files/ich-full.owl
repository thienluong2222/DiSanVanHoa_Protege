    <rdf:type rdf:resource="https://w3id.org/ich-mekong/ontology#EventHeritage"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ich:typicallyIncludes rdf:resource="https://w3id.org/ich-mekong/ontology#LeTeThanNong"/>
    <ich:typicallyIncludes rdf:resource="https://w3id.org/ich-mekong/ontology#TongTau"/>
