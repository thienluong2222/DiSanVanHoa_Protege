ex:Admin_SocTrang_pre2025 a owl:NamedIndividual,
        ich:AdminUnit ;
    rdfs:label "Tỉnh Sóc Trăng"@vi ;
    ich:adminLevel "province" ;
    ich:coversPlace ex:Place_SocTrangArea ;
    ich:succeededBy ex:Admin_TPCanTho_2025 ;
    ich:validTo "2025-06-11T00:00:00"^^xsd:dateTime ;
    ich:verificationStatus "unverified" .

ex:Pair_A1 a owl:NamedIndividual,
        ich:ConfusablePair ;
    ich:discriminatorKind "cue",
        "temporal" ;
    ich:discriminatorNote "Cùng Khmer, cùng trang phục; phân biệt bằng ghe Ngo/thả đèn nước (Oóc Om Bóc) vs núi cát/tắm Phật (Chôl Chnăm Thmây) và hệ lịch."@vi ;
    ich:hasMember ex:CholChnamThmay,
        ex:OocOmBocSocTrang ;
    ich:verificationStatus "unverified" .

ex:Pair_B1 a owl:NamedIndividual,
        ich:ConfusablePair ;
    ich:discriminatorKind "cue",
        "place" ;
    ich:discriminatorNote "Cùng trên sông Cần Thơ, cùng cây bẹo; phân biệt bằng vị trí (GPS/OCR). Phong Điền thưa ghe hơn (yếu, tương đối, chưa có ngưỡng)."@vi ;
    ich:hasMember ex:ChoNoiCaiRang,
        ex:ChoNoiPhongDien ;
    ich:verificationStatus "unverified" .

ex:Pair_B2 a owl:NamedIndividual,
        ich:ConfusablePair ;
    ich:discriminatorKind "place" ;
    ich:discriminatorNote "Cùng cue chung; chỉ phân biệt bằng vị trí."@vi ;
    ich:hasMember ex:ChoNoiCaiRang,
        ex:ChoNoiNgaBay ;
    ich:verificationStatus "unverified" .

ex:Pair_B3 a owl:NamedIndividual,
        ich:ConfusablePair ;
    ich:discriminatorKind "place" ;
    ich:discriminatorNote "Sông Tiền vs sông Cần Thơ (OCR/GPS)."@vi ;
    ich:hasMember ex:ChoNoiCaiBe,
        ex:ChoNoiCaiRang ;
    ich:verificationStatus "unverified" .

